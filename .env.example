# Copy to .env and set your own values. Do not commit .env.
# JWT signing secret for the API. Use a long random string.
LADEN_JWT_SECRET=change-me

# Optional: seed passwords for a fresh database. Leave empty to have a
# random password generated and printed in the api log on first start.
LADEN_SEED_PW_LADEN=
LADEN_SEED_PW_GROK=
LADEN_SEED_PW_CALEB=
LADEN_SEED_PW_ADMIN=

# Optional: send mail through Resend. Empty means mail only goes to the outbox.
RESEND_API_KEY=

# Optional: token for the oracle's GitHub lookups. Empty disables them.
GITHUB_TOKEN=
